ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -pthread -B /home/cyh/miniconda3/envs/nerf2mesh39/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/cyh/miniconda3/envs/nerf2mesh39/include -I/home/cyh/miniconda3/envs/nerf2mesh39/include -fPIC -O2 -isystem /home/cyh/miniconda3/envs/nerf2mesh39/include -fPIC -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/TH -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/cyh/miniconda3/envs/nerf2mesh39/include/python3.9 -c
post_cflags = -O3 -std=c++14 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_shencoder -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/TH -I/home/cyh/miniconda3/envs/nerf2mesh39/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/cyh/miniconda3/envs/nerf2mesh39/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++14 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_shencoder -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_89,code=sm_89
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/cyh/projects/nerf2mesh/shencoder/build/temp.linux-x86_64-cpython-39/home/cyh/projects/nerf2mesh/shencoder/src/bindings.o: compile /home/cyh/projects/nerf2mesh/shencoder/src/bindings.cpp
build /home/cyh/projects/nerf2mesh/shencoder/build/temp.linux-x86_64-cpython-39/home/cyh/projects/nerf2mesh/shencoder/src/shencoder.o: cuda_compile /home/cyh/projects/nerf2mesh/shencoder/src/shencoder.cu







